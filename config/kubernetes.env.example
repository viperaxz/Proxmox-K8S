# Kubernetes Configuration
# Copy this file to kubernetes.env and fill in your values

# Domain for ingress (must be managed by Cloudflare)
DOMAIN="example.com"

# MetalLB IP range for LoadBalancer services
METALLB_IP_RANGE="192.168.1.230-192.168.1.250"

# NFS Server (your Proxmox IP or NAS)
NFS_SERVER="192.168.1.10"
NFS_PATH="/mnt/pve/nfs-share"

# TLS Certificate Mode:
#   letsencrypt - Production Let's Encrypt certificates (rate limited: 50 certs/week)
#   staging     - Let's Encrypt staging certificates (not trusted but no rate limits)
#   selfsigned  - Self-signed certificates (for development, no external requests)
TLS_MODE="staging"

# Cloudflare credentials for Let's Encrypt DNS challenge
CLOUDFLARE_EMAIL="your-email@example.com"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Grafana admin password (auto-generated if empty)
# GRAFANA_ADMIN_PASSWORD=""
